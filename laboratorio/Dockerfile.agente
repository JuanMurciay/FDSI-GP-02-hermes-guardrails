FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-pip git curl ca-certificates procps \
 && rm -rf /var/lib/apt/lists/* \
 && pip3 install --no-cache-dir --break-system-packages pytest \
 && npm install -g @opencode/cli@2.0.30 \
 && npm cache clean --force

# Usuario sin privilegios del laboratorio (uid 1001). N1 lo reemplaza por root a proposito.
RUN useradd -m -u 1001 -s /bin/bash lab \
 && mkdir -p /work && chown lab:lab /work

USER lab
WORKDIR /work
